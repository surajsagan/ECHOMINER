# Copy to apps/api/.env on the server (never commit it).
ENV=prod
PUBLIC_BASE_URL=https://echominer.in
SECRET_KEY=            # openssl rand -hex 32
OTP_PEPPER=            # openssl rand -hex 32
# Same password as POSTGRES_PASSWORD in .env.deploy
DATABASE_URL=postgresql+psycopg://echominer:CHANGE_ME@postgres:5432/echominer
LOG_LEVEL=INFO

# Open registration: leave empty. Set to a comma-separated domain list to restrict.
ALLOWED_EMAIL_DOMAINS=
TRUSTED_DEVICE_DAYS=180
MAX_FILES_PER_JOB=20
MAX_JOB_BYTES=209715200

# Brevo SMTP relay (Brevo > SMTP & API > SMTP). Needs DNS records only; no mailbox.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@echominer.in
MAIL_FROM_NAME=EchoMiner
MAIL_REPLY_TO=aiechominer@gmail.com
REGISTRATION_NOTIFY=surajbm@jssuni.edu.in,madhub@jssuni.edu.in,aiechominer@gmail.com

# Google reCAPTCHA v3 (secret key; the site key goes in .env.deploy)
CAPTCHA_PROVIDER=recaptcha
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
