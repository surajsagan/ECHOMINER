{
  "version": "1.0.0",
  "effective_from": "2026-08-08",
  "engine_compat": ["echominer-engine/2.0.0"],
  "notes": "Canonical field set derived from echo_extractor.py (v1, 47 columns). 'Age / Gender' is split into two fields (age_years, sex), giving 48 canonical variables and aligning with the 48-variable figure used in the manuscript. Legacy column names are preserved in `legacy` for byte-compatible v1 export.",
  "fields": [
    {"code": "patient_name",        "label": "Name",            "legacy": "Name",          "group": "identity",     "type": "text",    "unit": null},
    {"code": "age_years",           "label": "Age (years)",     "legacy": "Age / Gender",  "group": "identity",     "type": "integer", "unit": "years", "min": 0, "max": 120},
    {"code": "sex",                 "label": "Sex",             "legacy": "Age / Gender",  "group": "identity",     "type": "enum",    "unit": null, "values": ["M", "F"]},
    {"code": "address",             "label": "Address",         "legacy": "Address",       "group": "identity",     "type": "text",    "unit": null},

    {"code": "ao_diameter",         "label": "Aortic root",     "legacy": "AO",            "group": "mmode", "type": "number", "unit": "mm", "min": 5,  "max": 70},
    {"code": "la_diameter",         "label": "Left atrium",     "legacy": "LA",            "group": "mmode", "type": "number", "unit": "mm", "min": 5,  "max": 90},
    {"code": "rv_diameter",         "label": "Right ventricle", "legacy": "RV",            "group": "mmode", "type": "number", "unit": "mm", "min": 5,  "max": 70},
    {"code": "lvid_d",              "label": "LVID diastole",   "legacy": "L VID d",       "group": "mmode", "type": "number", "unit": "mm", "min": 10, "max": 100},
    {"code": "lvid_s",              "label": "LVID systole",    "legacy": "L VID s",       "group": "mmode", "type": "number", "unit": "mm", "min": 5,  "max": 95},
    {"code": "ivs_d",               "label": "IVS diastole",    "legacy": "IVS d",         "group": "mmode", "type": "number", "unit": "mm", "min": 2,  "max": 35},
    {"code": "ivs_s",               "label": "IVS systole",     "legacy": "IVS s",         "group": "mmode", "type": "number", "unit": "mm", "min": 2,  "max": 40},
    {"code": "lvpw_d",              "label": "LVPW diastole",   "legacy": "LVPW d",        "group": "mmode", "type": "number", "unit": "mm", "min": 2,  "max": 35},
    {"code": "lvpw_s",              "label": "LVPW systole",    "legacy": "LVPW s",        "group": "mmode", "type": "number", "unit": "mm", "min": 2,  "max": 40},

    {"code": "edv",                 "label": "End-diastolic volume", "legacy": "EDV", "group": "volumetric", "type": "number", "unit": "ml", "min": 5, "max": 500},
    {"code": "esv",                 "label": "End-systolic volume",  "legacy": "ESV", "group": "volumetric", "type": "number", "unit": "ml", "min": 2, "max": 450},
    {"code": "sv",                  "label": "Stroke volume",        "legacy": "SV",  "group": "volumetric", "type": "number", "unit": "ml", "min": 2, "max": 200},
    {"code": "ef",                  "label": "Ejection fraction",    "legacy": "EF",  "group": "function",   "type": "number", "unit": "%",  "min": 5, "max": 90},
    {"code": "fs",                  "label": "Fractional shortening","legacy": "FS",  "group": "function",   "type": "number", "unit": "%",  "min": 2, "max": 65},

    {"code": "mv_doppler",          "label": "Mitral valve Doppler",    "legacy": "MV", "group": "doppler", "type": "text", "unit": null},
    {"code": "tv_doppler",          "label": "Tricuspid valve Doppler", "legacy": "TV", "group": "doppler", "type": "text", "unit": null},
    {"code": "av_doppler",          "label": "Aortic valve Doppler",    "legacy": "AV", "group": "doppler", "type": "text", "unit": null},
    {"code": "pv_doppler",          "label": "Pulmonary valve Doppler", "legacy": "PV", "group": "doppler", "type": "text", "unit": null},

    {"code": "finding_left_ventricle",   "label": "Left Ventricle",   "legacy": "Left Ventricle",   "group": "findings", "type": "text", "unit": null},
    {"code": "finding_left_atrium",      "label": "Left Atrium",      "legacy": "Left Atrium",      "group": "findings", "type": "text", "unit": null},
    {"code": "finding_right_ventricle",  "label": "Right Ventricle",  "legacy": "Right Ventricle",  "group": "findings", "type": "text", "unit": null},
    {"code": "finding_right_atrium",     "label": "Right Atrium",     "legacy": "Right Atrium",     "group": "findings", "type": "text", "unit": null},
    {"code": "finding_aorta",            "label": "Aorta",            "legacy": "Aorta",            "group": "findings", "type": "text", "unit": null},
    {"code": "finding_pulmonary_artery", "label": "Pulmonary Artery", "legacy": "Pulmonary Artery", "group": "findings", "type": "text", "unit": null},
    {"code": "finding_ivs",              "label": "IVS",              "legacy": "IVS",              "group": "findings", "type": "text", "unit": null},
    {"code": "finding_ias",              "label": "IAS",              "legacy": "IAS",              "group": "findings", "type": "text", "unit": null},
    {"code": "finding_mitral_valve",     "label": "Mitral Valve",     "legacy": "Mitral Valve",     "group": "findings", "type": "text", "unit": null},
    {"code": "finding_aortic_valve",     "label": "Aortic Valve",     "legacy": "Aortic Valve",     "group": "findings", "type": "text", "unit": null},
    {"code": "finding_tricuspid_valve",  "label": "Tricuspid Valve",  "legacy": "Tricuspid Valve",  "group": "findings", "type": "text", "unit": null},
    {"code": "finding_pulmonary_valve",  "label": "Pulmonary Valve",  "legacy": "Pulmonary Valve",  "group": "findings", "type": "text", "unit": null},
    {"code": "finding_pericardium",      "label": "Pericardium",      "legacy": "Pericardium",      "group": "findings", "type": "text", "unit": null},
    {"code": "finding_colour_doppler",   "label": "Colour Doppler",   "legacy": "Colour Doppler",   "group": "findings", "type": "text", "unit": null},
    {"code": "finding_doppler_study",    "label": "Doppler Study",    "legacy": "Doppler Study",    "group": "findings", "type": "text", "unit": null},
    {"code": "finding_others",           "label": "Others",           "legacy": "Others",           "group": "findings", "type": "text", "unit": null},

    {"code": "impression_1",  "label": "Impression 1",  "legacy": "IMPRESSION1",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_2",  "label": "Impression 2",  "legacy": "IMPRESSION2",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_3",  "label": "Impression 3",  "legacy": "IMPRESSION3",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_4",  "label": "Impression 4",  "legacy": "IMPRESSION4",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_5",  "label": "Impression 5",  "legacy": "IMPRESSION5",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_6",  "label": "Impression 6",  "legacy": "IMPRESSION6",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_7",  "label": "Impression 7",  "legacy": "IMPRESSION7",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_8",  "label": "Impression 8",  "legacy": "IMPRESSION8",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_9",  "label": "Impression 9",  "legacy": "IMPRESSION9",  "group": "impression", "type": "text", "unit": null},
    {"code": "impression_10", "label": "Impression 10", "legacy": "IMPRESSION10", "group": "impression", "type": "text", "unit": null}
  ],
  "provenance_fields": [
    {"code": "_source_file",       "label": "Source file",        "type": "text"},
    {"code": "_source_pages",      "label": "Source page(s)",     "type": "text"},
    {"code": "_record_index",      "label": "Record # in file",   "type": "integer"},
    {"code": "_impression_overflow","label": "Impressions beyond 10", "type": "integer"},
    {"code": "_field_completeness","label": "Field completeness (%)", "type": "number"},
    {"code": "_warnings",          "label": "Parse warnings",     "type": "text"}
  ]
}
