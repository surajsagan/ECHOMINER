# Server-side compose settings. Copy to .env.deploy on the server (never commit it).
POSTGRES_USER=echominer
POSTGRES_DB=echominer
# openssl rand -hex 24  -- must match the password inside DATABASE_URL in apps/api/.env
POSTGRES_PASSWORD=

# Public (browser) values, baked into the web build.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
